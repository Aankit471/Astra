# ASTRA Healthcare Referral Platform - Environment Configuration

# Supabase Configuration (Required for live Supabase mode: astra-production-demo)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API Mode Configuration
# Set to 'true' to force offline MockDatabase mode for local testing without Supabase
# Set to 'false' to connect to live Supabase / REST backend
VITE_USE_MOCK_API=true

# Optional REST Backend fallback URL (if using custom backend instead of Supabase direct)
VITE_API_BASE_URL=/api
